<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Agent Console</title>
<link rel="stylesheet" href="/static/app.css?v={{.AssetVersion}}">
<script>try{var _t=localStorage.getItem('theme');if(_t)document.documentElement.dataset.theme=_t;}catch(e){}</script>
</head><body>
<div class="app">
<aside class="sidebar">
  <div class="brand">🗓️ Agent Console</div>
  <nav>
    <button data-tab="chat">💬 Chat</button>
    <div class="grp">You</div>
    <button data-tab="calendar" class="active">Calendar</button>
    <button data-tab="adddata">Add Data <span id="addBadge" class="mut" style="display:none"></span></button>
    <button data-tab="week">My Week</button>
    <button data-tab="tasks">Tasks</button>
    <button data-tab="directory">Directory</button>
    <button data-tab="activity">Activity</button>
    <div class="grp">Operator</div>
    <button data-tab="security">Security</button>
    <button data-tab="prompts">Prompts</button>
    <button data-tab="sampling">Sampling</button>
    <button data-tab="models">Models</button>
    <button data-tab="runtime">Runtime</button>
    <button data-tab="skills">Skills</button>
    <button data-tab="retrieval">Retrieval</button>
    <button data-tab="rag">RAG lab</button>
    <button data-tab="grammar">Grammar</button>
    <button data-tab="policies">Policies</button>
    <button data-tab="budgets">Budgets</button>
    <button data-tab="eval">Eval</button>
  </nav>
  <button id="themeToggle" class="switch" onclick="toggleTheme()" style="cursor:pointer">🌙 Dark</button>
  <a id="surfaceSwitch" class="switch" href="/"></a>
</aside>
<main>
  <section id="chat" class="hide">
    <div class="chatwrap">
      <div class="card" style="flex:2;min-width:0">
        <strong>Chat</strong> <span class="mut">— ask about your emails &amp; this week; grounded in the scrubbed corpus, retrieved text treated as untrusted data (M8); dates come from the host clock, not emails</span>
        <div id="chatlog" class="chatlog"></div>
        <div class="chatrow"><input id="chatq" placeholder="e.g. what's going on this week? what's today's date?"><button class="go" onclick="sendChat()">Send</button></div>
        <div class="chatfoot"><span id="chatStatus" class="mut"></span><button class="ghost chatclear" onclick="clearChat()">Clear</button></div>
        <label class="mut" style="display:block;margin-top:8px"><input type="checkbox" id="chatUnsafe"> controls off <span style="opacity:.7">— demo: show a poisoned email hijack the answer (then uncheck to see the control block it)</span></label>
      </div>
      <div class="card minical" style="flex:1;min-width:230px">
        <strong>This month</strong> <span class="mut">— click a day to open the calendar</span>
        <div id="miniCal"></div>
      </div>
    </div>
  </section>
  <section id="calendar">
    <div class="card">
      <strong>Calendar</strong> <span class="mut">— your month at a glance; add your own events, delete any, or accept an extracted one. Download as .ics to import into your family calendar — "new" skips what you already exported, so no duplicates.</span>
      <div style="margin-top:6px"><button class="go" onclick="openCreateModal()">➕ Add event</button>
        <button class="go" onclick="downloadNewICS()" style="margin-left:8px">⬇ Download new events (.ics)</button>
        <button class="ghost" onclick="exportAllICS()">Export all again</button>
        <span class="viewtoggle" style="margin-left:10px">
          <button class="ghost" id="vMonth" onclick="setView('month')">Month</button>
          <button class="ghost" id="vList" onclick="setView('list')">List</button>
        </span>
        <span id="icsMsg" class="mut" style="margin-left:8px"></span></div>
      <div id="monthView"></div>
      <div id="events" class="hide"></div>
    </div>
    <div class="card">
      <strong>Upcoming</strong> <span class="mut">— next things across meetings, tasks &amp; heads-ups</span>
      <div class="strip" id="deadlines"></div>
    </div>
  </section>
  <section id="adddata" class="hide">
    <div class="card">
      <strong>Add data</strong> <span class="mut">— drop a school email (.txt) and the agent extracts events, tasks &amp; contacts into your calendar and corpus</span>
      <p class="mut" id="inbox"></p>
      <div class="dz" id="dropzone">
        Drag a <b>.txt</b> email here, or <label class="link">choose a file<input id="file" type="file" accept=".txt" hidden></label>, or paste below.
        <div style="margin-top:8px"><textarea id="paste" rows="4" placeholder="paste email text…"></textarea></div>
        <div style="margin-top:8px"><button class="go" onclick="dropText()">Process email</button> <span id="dropmsg" class="mut"></span></div>
        <div id="dropResult" style="margin-top:10px"></div>
      </div>
      <div id="progressCard" class="card" style="display:none;margin-top:12px">
        <strong>Processing</strong> <span id="progressLine" class="mut"></span>
        <div style="background:#e2e8f0;border-radius:6px;height:8px;margin:8px 0;overflow:hidden"><div id="progressBar" style="background:#2563eb;height:8px;width:0%"></div></div>
        <div id="progressRecent"></div>
      </div>
    </div>
  </section>

  <section id="week" class="hide">
    <div class="card">
      <strong>My Week</strong> <span class="mut">— your kid's week from every processed email + the profile; click a day for the detail</span>
      <div style="margin-top:8px;display:flex;gap:8px;align-items:center">
        <button class="ghost" onclick="shiftWeek(-7)">‹</button>
        <span id="weekRange" class="mut"></span>
        <button class="ghost" onclick="shiftWeek(7)">›</button>
        <button class="ghost" onclick="loadWeekStrip()">This week</button>
      </div>
      <div id="weekStrip" class="strip" style="margin-top:8px"></div>
      <div id="weekDay" class="mut" style="margin-top:10px"></div>
      <div id="timeline" style="margin-top:8px"><span class="mut">loading…</span></div>
    </div>
    <div class="card">
      <strong>Child profile</strong> <span class="mut">— personalizes the day (arrival / lunch / dismissal anchors). Stays on this host, never sent anywhere.</span>
      <div id="profileForm" style="margin-top:8px"><span class="mut">loading…</span></div>
      <div style="margin-top:8px"><button class="ghost" onclick="addChild()">➕ Add child</button> <button class="go" onclick="saveProfile()">Save profile</button> <span id="profileMsg" class="mut"></span></div>
    </div>
  </section>

  <section id="tasks" class="hide">
    <div class="card hide" id="reviewCard">
      <strong>⚠ Needs your OK</strong> <span class="mut">— low-confidence or flagged extractions the agent wants you to confirm before trusting (it won't add them unattended)</span>
      <div id="reviewList" style="margin-top:8px"></div>
    </div>
    <div class="card">
      <strong>Tasks &amp; reminders</strong> <span class="mut">— the non-meeting things an email asks of you</span>
      <h3>To do</h3><div id="taskList"></div>
      <h3>Heads-up</h3><div id="headsList"></div>
      <h3>Actions (links)</h3><div id="actionList"></div>
      <div style="margin-top:12px"><a href="#" id="removedToggle" class="mut" onclick="toggleRemoved();return false;">Show removed</a></div>
      <div id="removedList" style="margin-top:6px"></div>
    </div>
    <div class="card">
      <strong>By email</strong> <span class="mut">— digest &amp; contacts the agent pulled</span>
      <div id="summaries"></div>
    </div>
  </section>

  <section id="activity" class="hide">
    <div class="card">
      <strong>Activity</strong> <span class="mut">— what the agent did, newest first, from the tamper-evident log. "Detailed" shows the raw tool calls (exec argv / fetch URL + allow/block + outcome); click a trace to replay its full timeline. Output is never logged.</span>
      <div style="margin-top:8px">
        <button class="ghost active" id="actPlain" onclick="setActView('plain')">Plain</button>
        <button class="ghost" id="actDetail" onclick="setActView('detail')">Detailed (tool calls)</button>
      </div>
      <div class="feed" id="feed" style="margin-top:8px"></div>
      <div id="commandList" class="hide" style="margin-top:8px"></div>
      <div class="card hide" id="replayCard" style="margin-top:8px"><strong>Trace replay</strong><pre id="replay"></pre></div>
    </div>
  </section>

  <section id="directory" class="hide">
    <div class="card">
      <strong>Directory</strong> <span class="mut">— school people &amp; contacts surfaced from your emails and the profile teachers (R5, host-only; stays on this host)</span>
      <div id="directoryList" style="margin-top:8px"><span class="mut">loading…</span></div>
    </div>
  </section>

  <section id="security" class="hide">
    <div class="card">
      <strong>Kill switch</strong> <span class="mut">— halt the agent (M18)</span>
      <div style="margin-top:8px">level: <span id="klevel" class="pill">—</span>
        <button class="ghost" onclick="setKill(0)">Resume</button>
        <button class="ghost" onclick="setKill(1)">Block actions</button>
        <button class="ghost" onclick="setKill(2)">Pause</button>
        <button class="ghost" onclick="setKill(3)">Full halt</button>
      </div>
    </div>
    <div class="card">
      <strong>Tool gateway (MCP)</strong> <span class="mut">— the agent reaches external tools only through here. Each server's tool manifest is pinned (approve); a changed manifest or a halt blocks it. A registered tool call runs through the egress-gated sandbox, so its host must be on the egress allow-list.</span>
      <div id="mcp" style="margin-top:8px"><span class="mut">loading…</span></div>
    </div>
    <div class="card">
      <strong>Register a tool server</strong> <span class="mut">— add a server by URL + the tool names it offers. Approve it to pin the manifest, then Invoke a tool (fetched through the sandbox).</span>
      <div style="margin-top:8px;display:flex;gap:8px;flex-wrap:wrap">
        <input id="mcpNewName" placeholder="name — e.g. weather" style="flex:1;min-width:120px">
        <input id="mcpNewURL" placeholder="https://host.on.allowlist/endpoint" style="flex:2;min-width:200px">
      </div>
      <div style="margin-top:6px"><input id="mcpNewTools" placeholder="tools (comma-separated) — e.g. forecast, alerts" style="width:100%"></div>
      <div style="margin-top:8px"><button class="go" onclick="registerMCP()">Register server</button> <span id="mcpNewMsg" class="mut"></span></div>
    </div>
    <div class="card">
      <strong>Config snapshots</strong> <span class="mut">— known-good bundles (M15/C10): snapshot the whole governed plane (prompts + sampling + policies) and roll it all back in one click.</span>
      <div style="margin-top:8px"><input id="bundleLabel" placeholder="e.g. before-prompt-tweak" style="width:50%"><button class="go" onclick="saveBundle()">Snapshot now</button></div>
      <div id="bundleList" style="margin-top:8px"><span class="mut">loading…</span></div>
    </div>
    <div class="card">
      <strong>Security scorecard</strong>
      <p class="mut">Run the full red-team suite against the live controls. Every attack should drop to 0%.</p>
      <button class="go" onclick="runScorecard()">Run scorecard</button>
      <span id="verdict"></span>
      <table id="score" class="hide"><thead><tr><th>technique</th><th>control</th><th>before</th><th>after</th><th></th></tr></thead><tbody></tbody></table>
    </div>
  </section>

  <section id="prompts" class="hide">
    <div class="card">
      <strong>Prompts</strong> <span class="mut">— governed system prompts (M14): versioned, hashed, rollback to default. Resolved by the LLM planner/coder/extractor when enabled.</span>
      <div id="promptList"><span class="mut">loading…</span></div>
    </div>
  </section>

  <section id="sampling" class="hide">
    <div class="card">
      <strong>Sampling</strong> <span class="mut">— governed decoding params (M19): temperature / max tokens / seed. A seed makes generations reproducible for eval &amp; forensics. Versioned, hashed, rollback.</span>
      <div id="samplingList"><span class="mut">loading…</span></div>
    </div>
  </section>
  <section id="models" class="hide">
    <div class="card">
      <strong>Models</strong> <span class="mut">— governed model bindings: the logical model each role (extractor, chat) routes to. Versioned, hashed, rollback; bundle-referenced. A local→frontier swap is where data-residency bites.</span>
      <div id="modelsList"><span class="mut">loading…</span></div>
    </div>
    <div class="card">
      <strong>Model catalog</strong> <span class="mut">— the DB-backed registry of which models exist: verified download URL + SHA pin (M10), local file, serve port/ctx. Single source of truth — <code>prepareassets</code> (download) and <code>modeld</code> (serve) read this same catalog. Consts are only the fail-closed bootstrap seed.</span>
      <div id="modelCatalog" style="margin-top:8px"><span class="mut">loading…</span></div>
      <div style="margin-top:12px;border-top:1px solid var(--line);padding-top:10px">
        <strong>Add / edit model</strong> <span class="mut">— same name edits in place (swap a model out). SHA pins the content (M10); leave empty for GGUF-magic verify only.</span>
        <div class="mgrid" style="margin-top:8px">
          <input id="mc_name" placeholder="logical name (e.g. planner)">
          <input id="mc_file" placeholder="file (e.g. llama-3.2-3b.gguf)">
          <input id="mc_url" placeholder="download URL (.gguf)" style="grid-column:1/3">
          <input id="mc_sha" placeholder="sha256 pin (optional)" style="grid-column:1/3">
          <input id="mc_port" type="number" placeholder="port">
          <input id="mc_ctx" type="number" placeholder="ctx">
          <select id="mc_kind" style="grid-column:1/3"><option value="">chat / completions model</option><option value="embedding">trained embedding model</option></select>
        </div>
        <div style="margin-top:8px"><button class="go" onclick="saveModel()">Save model</button> <span id="mcMsg" class="mut"></span></div>
      </div>
    </div>
    <div class="card">
      <strong>Frontier endpoints</strong> <span class="mut">— point a subject (NHI role) at an off-host frontier model: endpoint + a secret-by-pointer <code>KeyRef</code> (the env-var NAME holding the token, never the token). Binding a subject marks it frontier-bound, so the residency policy refuses it confidential list/export (data must not leave the host).</span>
      <div id="frontierList" style="margin-top:8px"><span class="mut">loading…</span></div>
      <div style="margin-top:12px;border-top:1px solid var(--line);padding-top:10px">
        <div class="mgrid">
          <input id="fr_subject" placeholder="subject (e.g. summarizer)">
          <input id="fr_keyref" placeholder="KeyRef env-var NAME (e.g. OPENAI_API_KEY)">
          <input id="fr_endpoint" placeholder="endpoint URL" style="grid-column:1/3">
        </div>
        <div style="margin-top:8px"><button class="go" onclick="saveFrontier()">Save binding</button> <span id="frMsg" class="mut"></span></div>
      </div>
    </div>
  </section>
  <section id="runtime" class="hide">
    <div class="card">
      <strong>Runtime health</strong> <span class="mut">— is the live model path up? (in-console preflight). Chat &amp; email extraction need the gateway + model servers; the governed tabs work without them. If chat is dead, look here.</span>
      <div id="runtimeOut" style="margin-top:8px"><span class="mut">loading…</span></div>
      <div style="margin-top:8px"><button class="ghost" onclick="loadRuntime()">Refresh</button> <span class="mut">serve models with <code>modeld -db &lt;inventory.db&gt;</code>; download with <code>prepareassets -db &lt;inventory.db&gt;</code></span></div>
    </div>
  </section>
  <section id="skills" class="hide">
    <div class="card">
      <strong>Skills</strong> <span class="mut">— on-demand instructions the agent loads. A skill is a supply-chain surface (LLM03): loading is fail-closed under sign + pin + scope. Approve pins the exact content you reviewed; an approved + trusted skill shapes Chat answers. A changed or untrusted skill is refused until re-approved.</span>
      <div id="skillList" style="margin-top:8px"><span class="mut">loading…</span></div>
    </div>
    <div class="card">
      <strong>Author a skill</strong> <span class="mut">— write instructions for your agent. Signed with your trusted author key, then Approve it above to make it shape Chat. Required tools must be within the agent's allow-set.</span>
      <div style="margin-top:8px"><input id="skNewName" placeholder="name — lowercase-dashes, e.g. allergy-watch" style="width:60%"></div>
      <textarea id="skNewInstr" rows="4" style="width:100%;margin-top:6px" placeholder="e.g. Always flag anything mentioning allergies or medical forms at the top of the answer."></textarea>
      <div id="skNewTools" class="mut" style="margin-top:6px"></div>
      <div style="margin-top:8px"><button class="go" onclick="authorSkill()">Create skill</button> <span id="skNewMsg" class="mut"></span></div>
    </div>
    <div class="card">
      <strong>Load (demo)</strong> <span class="mut">— run a catalog skill through the governed gate. Controls off bypasses sign/pin/scope so a poisoned skill's instructions leak (the attack); controls on refuse it.</span>
      <div style="margin-top:8px">
        <select id="skillLoadName"></select>
        <label class="mut" style="margin-left:8px"><input type="checkbox" id="skillUnsafe"> controls off</label>
        <button class="go" onclick="loadSkill()">Load</button>
      </div>
      <pre id="skillLoadOut" style="margin-top:8px;white-space:pre-wrap"></pre>
    </div>
  </section>
  <section id="retrieval" class="hide">
    <div class="card">
      <strong>Retrieval</strong> <span class="mut">— governed RAG read knobs: top-k per corpus. Versioned, hashed, rollback; bundle-referenced. Drives the chat read path live.</span>
      <div id="retrievalList"><span class="mut">loading…</span></div>
    </div>
  </section>
  <section id="rag" class="hide">
    <div class="card">
      <strong>RAG lab</strong> <span class="mut">— tune the retrieval ingestion pipeline: clean + chunk + (optionally) embed. Changing any knob re-runs ingestion over the whole corpus (the processed emails are the source of truth). Semantic mode boots a local embeddings model and ranks by cosine; FTS is lexical keyword search.</span>
      <div class="mgrid" style="margin-top:10px">
        <label class="mut">Mode<br><select id="rag_mode"><option value="fts">fts (keyword)</option><option value="semantic">semantic (vector)</option></select></label>
        <label class="mut">Embedder<br><select id="rag_embedder"></select></label>
        <label class="mut">Chunker<br><select id="rag_chunker"></select></label>
        <label class="mut">Chunk size<br><input id="rag_size" type="number" placeholder="e.g. 600"></label>
        <label class="mut">Overlap (fixed)<br><input id="rag_overlap" type="number" placeholder="e.g. 80"></label>
      </div>
      <div style="margin-top:10px">
        <button class="go" onclick="saveRAG()">Save &amp; reindex</button>
        <button class="ghost" onclick="reindexRAG()">Reindex now</button>
        <span id="ragMsg" class="mut"></span>
      </div>
      <div id="ragStats" style="margin-top:10px" class="mut"></div>
    </div>
    <div class="card">
      <strong>Enrich from a link</strong> <span class="mut">— fetch an allow-listed handbook URL into the knowledge base (R6: HITL + egress-gated, fetched in the MicroVM, indexed as untrusted)</span>
      <div style="margin-top:8px"><input id="enrichURL" placeholder="https://ps51eliashowe.org/handbook" style="width:70%"><button class="go" onclick="doEnrich()">Fetch</button></div>
      <div id="enrichOut" style="margin-top:10px" class="mut"></div>
    </div>
  </section>
  <section id="grammar" class="hide">
    <div class="card">
      <strong>Grammar</strong> <span class="mut">— governed output grammar (GBNF) the extractor constrains output with. A swapped grammar silently changes the output contract, so it is pinned like a prompt.</span>
      <div id="grammarList"><span class="mut">loading…</span></div>
    </div>
  </section>

  <section id="policies" class="hide">
    <div class="card">
      <strong>Policies</strong> <span class="mut">— governed security allowlists (M14/M16): egress hosts, exec argv[0]s. Versioned, hashed, rollback. Deny-by-default (private/IMDS, argcheck) still enforced regardless.</span>
      <div id="policyList"><span class="mut">loading…</span></div>
    </div>
  </section>

  <section id="budgets" class="hide">
    <div class="card">
      <strong>Budgets &amp; keys</strong> <span class="mut">— governed limits (M20): API rate (enforced here), token/concurrency/spend (gateway-side). Keys shown by POINTER (env-var name) + whether it's set — never the value.</span>
      <div id="budgetList"><span class="mut">loading…</span></div>
    </div>
  </section>

  <section id="eval" class="hide">
    <div class="card">
      <strong>Eval</strong> <span class="mut">— ground-truth F1 on the labeled emails (M11). The promotion gate = F1 ≥ baseline AND ADD ASR = 0.</span>
      <div style="margin-top:8px"><button class="go" onclick="runEval()">Run eval now</button> <span id="evalMode" class="mut"></span></div>
      <div id="flywheel" style="margin-top:8px" class="mut"></div>
      <div id="evalCases" style="margin-top:12px;border-top:1px solid var(--line);padding-top:10px"></div>
      <div id="evalHistory" style="margin-top:12px;border-top:1px solid var(--line);padding-top:10px"><span class="mut">loading…</span></div>
    </div>
  </section>

</main>
</div>
<script>const __CAP__="{{.CapToken}}";const SURFACE="{{.Surface}}";</script>
<script src="/static/app.js?v={{.AssetVersion}}"></script>
</body></html>
