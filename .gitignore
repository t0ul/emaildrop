# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
.venv*
.venv
.DS_Store
.cache
launch_vm
__pycache__/
set-up/vm-assets/alpine-root/*
set-up/vm-assets/alpine.iso
set-up/vm-assets/Image
set-up/vm-assets/vmlinuz-virt.gz
set-up/vm-assets/initramfs-virt
set-up/m-assets/initramfs-virt
set-up/vm-assets/initramfs.cpio.gz
set-up/vm-assets/qwen1.5b.gguf
set-up/vm-assets/agent_harness.sh 
set-up/vm-assets/vmlinuz-uncompressed
set-up/vm-assets/vmlinuz-virt.gz 
set-up/vm-assets/llama-3.2-3b.gguf
set-up/vm-assets/nomic-embed-text-v1.5.gguf
# VM saved-state snapshots (generated at runtime, large binary)
*.vmstate
set-up/vm-assets/golden.vmstate
# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/
vm-assets/alpine-root/
set-up/vm-assets/vmlinuz*
set-up/vm-assets/initramfs*
set-up/vm-assets/*.iso
set-up/vm-assets/*.gguf
set-up/vm-assets/detonationd
set-up/vm-assets/vmfetch

# telemetry / audit logs
logs/
*/control_plane/logs/
audit.jsonl

# --- email-to-calendar agent ---
# real (private) newsletters — NEVER commit; anonymized copies live in samples/
examples/
# watcher runtime dirs: keep the folders, ignore their contents
module-3/emaildrop/inbox/*
module-3/emaildrop/outbox/*
module-3/emaildrop/processed/*
module-3/emaildrop/logs/*
!module-3/emaildrop/**/.gitkeep

/launchvm

# governed control-plane demo logs
controlplane/logs/

# local reference, not a project doc
docs/course.txt

# internal planning/course docs — not public
docs/
